# Kopieren nach .env und anpassen. Ohne Änderungen startet die App im Demo-Modus
# mit synthetischen Daten – dafür sind weder Zugangsdaten noch eine Anlage nötig.

# --- Server -------------------------------------------------------------------
PORT=3000
# 0.0.0.0 = im ganzen Netz erreichbar (in Docker nötig), 127.0.0.1 = nur dieser Rechner
# HOST=0.0.0.0
# Schützt App und API mit einer Browser-Anmeldung (Benutzername beliebig).
# Pflicht, sobald die App im Netz erreichbar ist; dann auch HTTPS=true setzen.
# APP_PASSWORD=
APP_TIMEZONE=Europe/Berlin
LOG_LEVEL=info

# --- Datenquelle --------------------------------------------------------------
# demo | sungrow-cloud
ENERGY_PROVIDER=demo
# Abrufintervall; Standard 30 s (Demo) bzw. 300 s (Sungrow-Cloud)
# POLL_INTERVAL_SECONDS=

# --- Speicherung --------------------------------------------------------------
# Ohne DATABASE_URL werden Messwerte nur im Arbeitsspeicher gehalten.
# Mit `docker compose up -d db` läuft PostgreSQL lokal:
# DATABASE_URL=postgres://hef:hef@localhost:5432/home_energy_flow
# Host-Port der Docker-Datenbank, z. B. 5433, wenn lokal schon PostgreSQL auf 5432 läuft
# (dann auch in DATABASE_URL anpassen)
# DB_PORT=5432
RETENTION_DAYS=400
# Demo: so viele Tage simulierte Historie beim Start erzeugen
DEMO_BACKFILL_DAYS=7
# Sungrow: Lücken der letzten Tage aus dem Verlauf von iSolarCloud füllen (0 = aus)
HISTORY_BACKFILL_DAYS=7

# --- HTTPS --------------------------------------------------------------------
# iSolarCloud akzeptiert nur https-Redirect-URIs. true erzeugt ein selbst signiertes
# Zertifikat für localhost (Browserwarnung einmal bestätigen) oder nutzt eigene Dateien.
HTTPS=false
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# --- Sungrow iSolarCloud (nur für ENERGY_PROVIDER=sungrow-cloud) ---------------
# Alle drei Werte stammen von derselben App im Developer Portal deiner Region
# (Europa: https://developer-api.isolarcloud.eu). Alternativ config.json mit
# { "appKey", "secretKey", "appId" } im Projektordner.
SUNGROW_APP_ID=
SUNGROW_APP_KEY=
SUNGROW_APP_SECRET=
SUNGROW_API_BASE_URL=https://gateway.isolarcloud.eu
# Muss zeichengenau der im Developer Portal hinterlegten Redirect URI entsprechen
SUNGROW_REDIRECT_URI=https://localhost:3000/auth/callback
SUNGROW_TOKEN_FILE=.sungrow-token.json
# Nur nötig, wenn das Konto mehrere Anlagen hat
SUNGROW_PS_ID=

# Messpunkte – mit `npm run sungrow:inspect` an der eigenen Anlage prüfen.
# "83106" = Punkt der Anlage, "14:13149" = Punkt des Geräts vom Typ 14,
# "14:13149-13121" = Differenz zweier Gerätepunkte. Beispiel Hybrid-Wechselrichter (SH…RT) mit Batterie:
#   SUNGROW_POINT_PV=83033  SUNGROW_POINT_GRID=14:13149-13121  SUNGROW_POINT_BATTERY=14:13126-13150
SUNGROW_POINT_PV=83067
SUNGROW_POINT_LOAD=83106
SUNGROW_POINT_GRID=83549
# Leer = Batterieleistung aus der Bilanz berechnen
SUNGROW_POINT_BATTERY=
SUNGROW_POINT_SOC=83252
# positive | negative: Vorzeichen, das Sungrow bei Netzbezug bzw. beim Laden liefert
SUNGROW_GRID_IMPORT_SIGN=positive
SUNGROW_BATTERY_CHARGE_SIGN=positive

# --- Wetter und PV-Prognose (Open-Meteo, ohne API-Schlüssel) --------------------
WEATHER_ENABLED=true
# Standort; ohne Angabe aus der Sungrow-Anlage bzw. im Demo-Modus Mitte Deutschlands.
# Wird auf ~1 km gerundet an Open-Meteo übertragen.
# WEATHER_LATITUDE=
# WEATHER_LONGITUDE=
# Anlagenleistung in kWp; ohne Angabe keine PV-Prognose (Demo: 9,9 kWp)
# PV_PEAK_KW=
# Neigung in Grad (0 = waagerecht) und Ausrichtung (0 = Süd, -90 = Ost, 90 = West)
PV_TILT_DEG=30
PV_AZIMUTH_DEG=0
# Anteil der Modulleistung nach Verlusten; kleiner bei Verschattung
PV_PERFORMANCE_RATIO=0.85
