{
  "name": "@hef/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sungrow:inspect": "tsx --env-file-if-exists=../../.env src/sungrow-inspect.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@hef/energy-domain": "*",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "selfsigned": "^5.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
